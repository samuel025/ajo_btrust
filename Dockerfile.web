FROM node:22-alpine AS build
WORKDIR /app
# Downloads can be slow or flaky on some networks: retry patiently instead of failing the build.
ENV npm_config_fetch_retries=6 npm_config_fetch_retry_mintimeout=20000 npm_config_fetch_timeout=180000
COPY package.json package-lock.json ./
COPY packages/core/package.json packages/core/
COPY packages/bot/package.json packages/bot/
COPY apps/web/package.json apps/web/
RUN npm ci --workspace @ajo/web --include-workspace-root --ignore-scripts
COPY packages/core packages/core
COPY apps/web apps/web
# The coordinator's public key (npub) that new groups use by default.
ARG VITE_COORDINATOR=""
ENV VITE_COORDINATOR=$VITE_COORDINATOR
RUN npm run build -w @ajo/web

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist /srv
