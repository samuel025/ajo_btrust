FROM node:22-alpine
WORKDIR /app
# Downloads can be slow or flaky on some networks: retry patiently instead of failing the build.
ENV npm_config_fetch_retries=6 npm_config_fetch_retry_mintimeout=20000 npm_config_fetch_timeout=180000
COPY package.json package-lock.json ./
COPY packages/core/package.json packages/core/
COPY packages/bot/package.json packages/bot/
COPY apps/web/package.json apps/web/
RUN npm ci --workspace @ajo/bot --include-workspace-root --ignore-scripts
COPY packages/core packages/core
COPY packages/bot packages/bot
ENV NODE_ENV=production
USER node
# Reads BOT_NSEC, RELAYS, ORGANIZERS (or GROUPS) and optionally GEMINI_API_KEY from the environment.
CMD ["npm", "run", "start", "-w", "@ajo/bot"]
