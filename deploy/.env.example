# Your domain, pointed at this server. Caddy gets an HTTPS certificate for it automatically.
# Use ":80" to run on plain http (for a local trial).
SITE_ADDRESS=ajo.example.com

# The coordinator bot's secret key (nsec1...) and its public key (npub1...).
# Make a pair with:  npm run keygen -w @ajo/bot
BOT_NSEC=
COORDINATOR_NPUB=

# Which organizers' groups this bot runs: comma-separated npubs. Leave empty to list groups by hand in GROUPS.
ORGANIZERS=
GROUPS=

# Optional: let Google Gemini write the assistant's answers (free key from aistudio.google.com/apikey).
# Leave empty to use the built-in templates. See the README's privacy note before turning this on.
GEMINI_API_KEY=
